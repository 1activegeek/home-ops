+_SAFE_KEY_RE = re.compile(r"[A-Za-z0-9_-]{1,64}")
+
+
+def safe_user_key(user_id, platform=None) -> str:
+    """Collapse a platform-supplied user identifier into a filesystem-safe,
+    platform-qualified directory name.
+
+    Platform IDs that are already safe tokens (Slack ``U03G89W2A10``, Telegram
+    numeric IDs, Discord snowflakes) stay human-readable — qualified as
+    ``<platform>-<id>`` when the platform is known so equal raw IDs from
+    different platforms can never collide. Anything else (emails, Matrix MXIDs,
+    unicode display handles, hostile values like ``../../etc``) is reduced to a
+    stable ``h-<sha256[:20]>`` digest, so an attacker-controlled identifier can
+    never contribute raw path components under ``memories/users/``.
+
+    ``platform`` is normalized through ``.value`` first: the agent passes a plain
+    string ("matrix") while the gateway passes a ``Platform`` enum, and
+    ``str(Platform.MATRIX)`` is "Platform.MATRIX". Without this the two callers
+    derive DIFFERENT keys for the same person and their USER.md silently forks.
+    """
+    uid = str(user_id)
+    plat = getattr(platform, "value", platform)
+    plat = str(plat) if plat else None
+    if _SAFE_KEY_RE.fullmatch(uid) and (plat is None or _SAFE_KEY_RE.fullmatch(plat)):
+        return f"{plat}-{uid}" if plat else uid
+    raw = f"{plat or ''}:{uid}"
+    return "h-" + hashlib.sha256(raw.encode("utf-8")).hexdigest()[:20]
 
 
